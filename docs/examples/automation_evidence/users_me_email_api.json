{
  "feature": "Request User Email Change API",
  "evidence": {
    "api": {
      "method": "PUT",
      "endpoint": "/v1/users/me/email",
      "headers": {
        "x-api-key": "[REDACTED_API_KEY]",
        "Authorization": "Bearer [REDACTED_TOKEN]"
      },
      "valid_payload": {
        "new_email": "testemailchange+1234567890@mailinator.com"
      },
      "success_response": {
        "code": "OK",
        "message": "Data saved",
        "data": null
      },
      "negative_cases": [
        {
          "title": "Email already taken",
          "payload": {
            "new_email": "existing@example.com"
          },
          "expected_status": 422,
          "expected_response": {
            "code": "NOKUNPROC",
            "message": "email already exists",
            "data": null
          }
        },
        {
          "title": "Expired verification code",
          "method": "GET",
          "endpoint": "/v1/users/verify-email",
          "query": {
            "code": "expired-code"
          },
          "expected_status": 410,
          "expected_response": {
            "code": "EXPIRED",
            "message": "Verification link has expired",
            "data": null
          }
        }
      ],
      "verify_email": {
        "method": "GET",
        "endpoint": "/v1/users/verify-email",
        "query": {
          "code": "[REDACTED_VERIFICATION_CODE]"
        },
        "success_response": {
          "code": "OK",
          "message": "Email updated successfully",
          "data": null
        }
      },
      "security_notes": [
        "Use synthetic users only because this endpoint starts an email-change flow.",
        "Do not store real bearer tokens or API keys in evidence files.",
        "Do not store raw verification codes in docs or reports.",
        "Live staging currently returns Data saved with null data for successful requests.",
        "Live staging currently returns 422 NOKUNPROC for duplicate email requests.",
        "Live staging currently returns plain 404 for GET /v1/users/verify-email even though the API evidence defines it."
      ]
    }
  }
}
