# ── Environment: production ───────────────────────────────────────────────────
# Copy to .env and fill in real values before running tests against production.
# IMPORTANT: PLAYWRIGHT_IGNORE_HTTPS_ERRORS must remain false in production.
# IMPORTANT: All secrets must be sourced from the secret manager, not this file.
ENV=production

# ── AI Provider ───────────────────────────────────────────────────────────────
# Production uses Claude directly via Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
MODEL_TIER=production

# ── App URLs (production) ─────────────────────────────────────────────────────
HONO_API_URL=https://api.thehono.com
HONO_WEB_URL=https://app.thehono.com
HONO_CMS_URL=https://cms.thehono.com
HONO_API_KEY=your_production_api_key

# ── Test credentials (read-only production accounts) ─────────────────────────
STAGING_EMAIL=your_prod_readonly_user@email.com
STAGING_PASSWORD=your_prod_password
CMS_EMAIL=your_prod_cms_admin@email.com
CMS_PASSWORD=your_prod_cms_password
TEST_USER_PASSWORD=SecureTestPass123!

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=QA
JIRA_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
MANUAL_TRIGGER_SECRET=generate_with_openssl_rand_hex_32

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxx
TELEGRAM_QA_LEADS_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_QA_TEAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_QA_OPS_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_QA_BUGS_CHAT_ID=-100xxxxxxxxxx

# ── Pipeline settings ─────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
APPROVAL_REQUIRED=true
APPROVAL_MODE=always
USE_PERSISTENT_CHECKPOINTER=true
CHECKPOINTS_DB_PATH=checkpoints/pipeline_state.db

# ── Playwright ────────────────────────────────────────────────────────────────
# MUST be false in production — settings.py will raise if this is true with ENV=production
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=false

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./knowledge_base/vector_store
