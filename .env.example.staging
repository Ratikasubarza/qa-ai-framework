# ── Environment: staging ─────────────────────────────────────────────────────
# Copy to .env and fill in real values before running tests against staging.
ENV=staging

# ── AI Provider ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── App URLs (staging) ────────────────────────────────────────────────────────
HONO_API_URL=https://api-dev.thehono.com
HONO_WEB_URL=https://app-dev.thehono.com
HONO_CMS_URL=https://cms-dev.thehono.com
HONO_API_KEY=your_api_key

# ── Test credentials (staging accounts) ──────────────────────────────────────
STAGING_EMAIL=your_staging_user@mailinator.com
STAGING_PASSWORD=your_staging_password
CMS_EMAIL=your_cms_admin@email.com
CMS_PASSWORD=your_cms_admin_password
TEST_USER_PASSWORD=TestPass123!

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=QA
JIRA_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
MANUAL_TRIGGER_SECRET=generate_with_openssl_rand_hex_32

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxx
TELEGRAM_QA_LEADS_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_QA_TEAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_QA_OPS_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_QA_BUGS_CHAT_ID=-100xxxxxxxxxx

# ── Pipeline settings ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APPROVAL_REQUIRED=true
APPROVAL_MODE=smart
USE_PERSISTENT_CHECKPOINTER=false

# ── Playwright ────────────────────────────────────────────────────────────────
# Staging may use self-signed certs — set true only when confirmed with DevOps
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=false

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./knowledge_base/vector_store
